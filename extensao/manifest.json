{
  "manifest_version": 3,
  "name": "Lançador · Consultas",
  "short_name": "Lançador",
  "version": "1.3.0",
  "description": "Consulta no Detran e no IPVA as placas da aba Consultas e envia pelo WhatsApp Web os avisos de recibo da aba Recibos do Lançador de Notas. Feito por Rafinhadr.",
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "action": {
    "default_title": "Lançador · Consultas",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/mascote-16.png",
      "32": "icones/mascote-32.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "downloads",
    "debugger",
    "notifications"
  ],
  "host_permissions": [
    "https://app.altimus.com.br/*",
    "https://*.detran.sp.gov.br/*",
    "https://*.fazenda.sp.gov.br/*",
    "https://web.whatsapp.com/*",
    "https://*.supabase.co/*",
    "https://*.vercel.app/*",
    "https://github.com/*",
    "https://objects.githubusercontent.com/*",
    "https://release-assets.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.altimus.com.br/*",
        "https://web.whatsapp.com/*",
        "https://*.detran.sp.gov.br/*",
        "https://*.fazenda.sp.gov.br/*"
      ],
      "js": [
        "overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "mascote/*.gif"
      ],
      "matches": [
        "https://app.altimus.com.br/*",
        "https://web.whatsapp.com/*",
        "https://*.detran.sp.gov.br/*",
        "https://*.fazenda.sp.gov.br/*"
      ]
    }
  ]
}
